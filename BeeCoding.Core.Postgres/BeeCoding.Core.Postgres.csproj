<Project Sdk="Microsoft.NET.Sdk">

  <!-- The PostgreSQL migrations of AppDbContext. The SQLite ones live in BeeCoding.Core; a model change needs one of each
       (scripts/ef-add.sh). Only loaded when Database:Provider=postgres (Program.cs names this assembly). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BeeCoding.Migrations.Postgres</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BeeCoding.Core\BeeCoding.Core.csproj" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
  </ItemGroup>

</Project>
