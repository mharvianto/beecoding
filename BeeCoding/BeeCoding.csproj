<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="ClientApp/**" />
    <Content Remove="ClientApp/**" />
    <None Remove="ClientApp/**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets/fonts/*.ttf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Build the Vue SPA into wwwroot on `dotnet publish` (skip with -p:BuildClient=false).
    Publish-only so plain `dotnet build` / `dotnet run` stay fast in dev (use the Vite
    dev server there). The static-web-assets glob runs before this target creates the
    files, so CopyClientToPublish below copies wwwroot into the output afterwards.
  -->
  <Target Name="BuildClientApp" BeforeTargets="Publish" Condition="'$(BuildClient)' != 'false'">
    <Exec Command="npm ci" WorkingDirectory="ClientApp" />
    <Exec Command="npm run build" WorkingDirectory="ClientApp" />
  </Target>

  <Target Name="CopyClientToPublish" AfterTargets="Publish" Condition="Exists('wwwroot')">
    <ItemGroup>
      <_ClientPublishFiles Include="wwwroot/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_ClientPublishFiles)" DestinationFiles="@(_ClientPublishFiles->'$(PublishDir)wwwroot/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\BeeCoding.Core\BeeCoding.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Fido2" Version="4.2.0" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.11" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.17.0" />
    <PackageReference Include="SkiaSharp" Version="4.151.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.151.1" />
    <PackageReference Include="StackExchange.Redis" Version="3.2.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.17.0" />
  </ItemGroup>

</Project>
